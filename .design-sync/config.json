{
  "pkg": "outvers-next",
  "globalName": "OutversUI",
  "shape": "package",
  "projectId": "d4bdf0b4-d25d-4f3e-bbb3-3c55e915d333",
  "tsconfig": ".design-sync/tsconfig.sync.json",
  "buildCmd": "node .design-sync/build-styles.mjs",
  "cssEntry": ".design-sync/compiled-styles.css",
  "guidelinesGlob": ["DESIGN.md"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "620x460" },
    "Sheet": { "cardMode": "single", "viewport": "680x520" },
    "DropdownMenu": { "cardMode": "single", "viewport": "460x440" },
    "Select": { "cardMode": "single", "viewport": "460x420" },
    "Tooltip": { "cardMode": "single", "viewport": "480x260" },
    "Table": { "cardMode": "column" },
    "ResponsiveTable": { "cardMode": "column" },
    "Progress": { "cardMode": "single", "primaryStory": "WithLabel" },
    "Textarea": { "cardMode": "column" },
    "ExperienceCard": { "cardMode": "single", "viewport": "480x560" }
  },
  "componentSrcMap": {
    "Accordion": "components/ui/accordion.tsx",
    "Alert": "components/ui/alert.tsx",
    "Avatar": "components/ui/avatar.tsx",
    "Badge": "components/ui/badge.tsx",
    "Breadcrumb": "components/ui/breadcrumb.tsx",
    "Button": "components/ui/button.tsx",
    "Card": "components/ui/card.tsx",
    "Dialog": "components/ui/dialog.tsx",
    "DropdownMenu": "components/ui/dropdown-menu.tsx",
    "Input": "components/ui/input.tsx",
    "Label": "components/ui/label.tsx",
    "Progress": "components/ui/progress.tsx",
    "RadioGroup": "components/ui/radio-group.tsx",
    "Select": "components/ui/select.tsx",
    "Separator": "components/ui/separator.tsx",
    "Sheet": "components/ui/sheet.tsx",
    "Skeleton": "components/ui/skeleton.tsx",
    "Table": "components/ui/table.tsx",
    "Tabs": "components/ui/tabs.tsx",
    "Textarea": "components/ui/textarea.tsx",
    "Toaster": "components/ui/toaster.tsx",
    "Tooltip": "components/ui/tooltip.tsx",
    "ResponsiveTable": "components/ui/responsive-table.tsx",
    "ExperienceCard": "components/experience-card.tsx",
    "BookingStatusBadge": "components/booking-status-badge.tsx",
    "TrustBadge": "components/trust-badge.tsx",
    "ReviewStars": "components/reviews/review-stars.tsx",
    "EmptyState": "components/empty-state.tsx",
    "DashboardBookingsEmpty": "components/dashboard-bookings-empty.tsx",
    "SearchEmptyState": "components/search/search-empty-state.tsx",
    "CollectionPageSkeleton": "components/collection-page-skeleton.tsx",
    "HomeHowItWorks": "components/home/how-it-works.tsx",
    "HomeTrust": "components/home/trust.tsx",
    "ActiveFilterChips": "components/search/active-filter-chips.tsx",
    "ViewToggle": "components/search/view-toggle.tsx",
    "CompareToggle": "components/compare/toggle.tsx",
    "LanguageSelector": "components/language-selector.tsx",
    "ThemeToggle": "components/theme-toggle.tsx",
    "RecentlyViewedRail": "components/recently-viewed/rail.tsx"
  }
}
