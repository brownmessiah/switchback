# ========== REQUIRED (M1) ==========

# Neon Postgres connection string (ap-south-1 / Mumbai region).
# Use the POOLED url for app code; use the DIRECT url only for drizzle-kit migrate.
DATABASE_URL=postgres://user:password@host.aws.neon.tech:5432/outvers?sslmode=require

# better-auth session signing secret. Generate via: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-32-or-more-char-random-secret

# App URL (used for OAuth redirects, email links, JSON-LD canonical URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========== AUTH (M2 / M3) ==========

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ========== PAYMENTS (M2 / ADR-0001, 0016) ==========

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ========== AI (M4 / ADR-0010) ==========

OPENAI_API_KEY=

# ========== EMAIL (M2) ==========

RESEND_API_KEY=
# Envelope sender for transactional email (vendor welcome + KYC decision).
# Must be on a domain verified with Resend (SPF/DKIM/DMARC) or delivery is
# rejected. Defaults to "Outvers <hello@outvers.com>" when unset.
EMAIL_FROM=

# ========== MAPS ==========

MAPBOX_TOKEN=

# ========== REAL-TIME (M3) ==========

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ========== RATE LIMIT / IDEMPOTENCY (M2) ==========

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ========== OBSERVABILITY ==========

SENTRY_DSN=
POSTHOG_API_KEY=

# ========== STORAGE (GCS — ADR-0019) ==========
# Public uploads bucket. Set GCS_BUCKET in prod (Cloud Run uses ADC — no keys).
# Leave unset in dev to use the local-disk adapter (public/uploads).
GCS_BUCKET=
# PRIVATE bucket for vendor KYC documents (government ID, selfie, PAN).
# Has NO public IAM binding — objects are served only via short-lived signed
# URLs through the admin-gated /api/admin/kyc-document route. Deliberately
# separate from GCS_BUCKET, which is world-readable: identity documents must
# never land there, and the code never falls back to it.
GCS_KYC_BUCKET=
# Optional: 'gcs' or 'local'. Defaults to GCS when GCS_BUCKET is set.
STORAGE_BACKEND=
