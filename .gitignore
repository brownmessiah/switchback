# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache
tests/e2e/.auth/

# uploaded media (LocalFileAdapter storage mock — runtime/test artifacts)
/public/uploads/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local MCP server config (contains API keys — do not commit)
.mcp.json

# self-contained local dev stack (Postgres cluster + Meilisearch binary/data)
.dev-stack/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/e2e/screenshots/
.gstack/
.worktrees/
.i18n-work/

# agent scratch + worktrees (local-only; tracked records under .scratch
# predating this rule stay tracked — git ignore does not untrack them)
.scratch/
.claude/worktrees/

# local showcase site + captured screenshots (build artifacts)
screenshots/
showcase/
outvers-showcase.zip

# design-sync workstream leftovers (never commit)
.design-sync/
.ds-sync/
ds-bundle/
